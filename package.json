{
  "name": "dropzone",
  "version": "1.2.2",
  "description": "Loadouts, tactical maps, artillery calculations, patch notes, and competitive videos",
  "author": "Jaden Trask",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "package:win": "electron-packager . Dropzone --platform=win32 --arch=x64 --out=release --overwrite --icon=app/assets/icon.ico --ignore=\"^/(release|test|scripts|screenshots|[.]preview-cache|[.]validation-cache|[.]git|[.]openai)\" --prune=true",
    "dev": "node scripts/preview.cjs",
    "install:runtime": "install-electron",
    "version:set": "node scripts/set-version.cjs",
    "configure:updates": "node scripts/configure-updates.cjs",
    "package:installer": "node scripts/set-version.cjs && electron-builder --config electron-builder.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "type": "module",
  "productName": "Dropzone",
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
